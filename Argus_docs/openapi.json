    "/api/employees/{employee_id}/time-travel": {
      "get": {
        "tags": [
          "Audits"
        ],
        "summary": "Reconstruct Employee State",
        "description": "Reconstruct an employee's record state at a specific past timestamp.\n\nAccessible to compliance_auditor only.\n\nTODO (PENDING_ABHINAV): Once Abhinav pushes the DB function (Week 8),\nreplace this mock with a real query:\nSELECT * FROM reconstruct_employee_state(:emp_id, :ts);",
        "operationId": "reconstruct_employee_state_api_employees__employee_id__time_travel_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Employee Id"
            }
          },
          {
            "name": "timestamp",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Target ISO timestamp",
              "title": "Timestamp"
            },
            "description": "Target ISO timestamp"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeTravelResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit-logs/export": {
      "get": {
        "tags": [
          "Audits"
        ],
        "summary": "Export Signed Evidence",
        "description": "Export the full audit trail as a cryptographically signed JSON file.\n\nAccessible to compliance_auditor only.",
        "operationId": "export_signed_evidence_api_audit_logs_export_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
