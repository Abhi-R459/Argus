              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Employees"
        ],
        "summary": "Deactivate Employee",
        "description": "Soft-delete an employee record. HR Admin only.\n\nSets is_active = false rather than removing the row, preserving\naudit_log foreign key integrity.",
        "operationId": "deactivate_employee_api_employees__employee_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Employee Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeDeactivateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/employees/{employee_id}/salary": {
      "post": {
        "tags": [
          "Employees"
        ],
        "summary": "Add Salary Record",
        "description": "Add a new salary record for an employee. HR Admin only.\n\nBusiness-rule enforcement (e.g., cannot decrease pay by >30%,\ncannot edit own salary) is handled by DB triggers once Abhinav's\nWeek 4 work lands.",
        "operationId": "add_salary_record_api_employees__employee_id__salary_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Employee Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SalaryCreate"
              }
