    "/api/audit-logs": {
      "get": {
        "tags": [
          "Audits"
        ],
        "summary": "List Audit Logs",
        "description": "Retrieve paginated audit log entries with optional filters.\n\nJoins audit_log \u2192 users to resolve actor_name.\nAccessible to compliance_auditor role only \u2014 enforced both by the\nrequire_role dependency and by the compliance_auditor Postgres pool\nwhich has SELECT-only access to audit_log.",
        "operationId": "list_audit_logs_api_audit_logs_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "actor_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by actor user_id",
              "title": "Actor Id"
            },
            "description": "Filter by actor user_id"
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "INSERT | UPDATE | DELETE",
              "title": "Action"
            },
            "description": "INSERT | UPDATE | DELETE"
          },
          {
            "name": "table_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by table name",
              "title": "Table Name"
            },
            "description": "Filter by table name"
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "INFO | WARNING | CRITICAL",
              "title": "Severity"
            },
            "description": "INFO | WARNING | CRITICAL"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_AuditLogItem_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/verify": {
      "post": {
        "tags": [
          "Audits"
        ],
        "summary": "Run Verification",
        "description": "Trigger the standalone verifier to scan the hash chain.\n\nAccessible to compliance_auditor only.\n\nTODO Week 6-7: Replace this mock body with a real subprocess call:\n\n    import asyncio, json\n    proc = await asyncio.create_subprocess_exec(\n        \"python\", \"-m\", \"db.verifier.cli\", \"--json\",\n        stdout=asyncio.subprocess.PIPE,\n        stderr=asyncio.subprocess.PIPE,\n    )\n    stdout, _ = await proc.communicate()\n    raw = json.loads(stdout)\n    return VerificationResult(**raw)\n\nThe verifier CLI lives in db/verifier/ (Abhinav's track, Week 5-6).\nUntil then, return the structured mock below so the frontend contract\nis exercised end-to-end.",
        "operationId": "run_verification_api_verify_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResult"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/suspicious-activity": {
      "get": {
        "tags": [
          "Audits"
        ],
        "summary": "List Suspicious Flags",
        "description": "List all suspicious activity flags, newest first.\n\nPopulated by Abhinav's Week 8 refresh_suspicious_activity_flags()\nprocedure. Returns empty list until then.",
        "operationId": "list_suspicious_flags_api_suspicious_activity_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SuspiciousFlagItem"
                  },
                  "type": "array",
                  "title": "Response List Suspicious Flags Api Suspicious Activity Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/suspicious-activity/{flag_id}/review": {
      "post": {
        "tags": [
          "Audits"
        ],
        "summary": "Review Suspicious Flag",
        "description": "Mark a suspicious activity flag as reviewed by the current auditor.",
        "operationId": "review_suspicious_flag_api_suspicious_activity__flag_id__review_post",
        "security": [
          {
