# Template only. Use hosting-provider secrets; never commit populated values.
# Supabase Google login works on a free provider address. See docs/PRODUCTION_LAUNCH.md.
APP_ENV=production
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
DATABASE_URL_HR_ADMIN=postgresql+asyncpg://hr_admin.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/app/certificates/supabase-ca.crt
DATABASE_URL_COMPLIANCE_AUDITOR=postgresql+asyncpg://compliance_auditor.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/app/certificates/supabase-ca.crt
CORS_ORIGINS=https://app.example.com
HR_ADMIN_EMAILS=REPLACE_WITH_REAL_HR_EMAIL
COMPLIANCE_AUDITOR_EMAILS=REPLACE_WITH_REAL_AUDITOR_EMAIL
PII_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_AES256_BASE64_KEY
AUDIT_SALT=REPLACE_WITH_UNIQUE_RANDOM_SALT_AT_LEAST_32_BYTES
AUDIT_CONTEXT_SECRET=REPLACE_WITH_EXISTING_DATABASE_CONTEXT_SECRET
AUDIT_CONTEXT_KEY_ID=REPLACE_WITH_INSTALLED_DATABASE_CONTEXT_KEY_ID
SIGNING_PRIVATE_KEY_PATH=/etc/secrets/verifier_private_key.pem
CHECKPOINT_PUBLIC_KEYS_DIR=/etc/secrets
# Signed checkpoints persist in PostgreSQL. Free hosting has no durable disk.
# To enable the separate private, read-only anchor, first publish a verified
# anchors.json, then set ANCHOR_STORE=github_repo and all four GITHUB_* values.
ANCHOR_STORE=none
GITHUB_ANCHOR_REPOSITORY=OWNER/PRIVATE_ANCHOR_REPOSITORY
GITHUB_ANCHOR_TOKEN=REPLACE_WITH_FINE_GRAINED_CONTENTS_READ_TOKEN
GITHUB_ANCHOR_BRANCH=main
GITHUB_ANCHOR_MIN_SEQUENCE=REPLACE_WITH_PUBLISHED_SEQUENCE
SUSPICIOUS_ACTIVITY_REFRESH_SECONDS=300
ALLOW_DEMO_ROLE_SWITCH=false
ALLOW_CONCURRENCY_DIAGNOSTICS=false
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
MAX_REQUEST_BODY_BYTES=1048576
BLIND_INDEX_RATE_LIMIT_PER_MINUTE=10
# Set only these public variables in the frontend hosting project.
VITE_SUPABASE_URL=https://PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
VITE_API_URL=https://api.example.com/api
VITE_ENABLE_DIAGNOSTICS=false
# Render Free may need about a minute to start after idling.
VITE_API_TIMEOUT_MS=90000
