# Compose consumes these values to build runtime connection URLs. Generate
# distinct random passwords (URL-safe characters are easiest for this template).
APP_ENV=development
POSTGRES_PASSWORD=
HR_ADMIN_PASSWORD=
COMPLIANCE_AUDITOR_PASSWORD=

# Compose ops jobs may use distinct provider-specific principals. The defaults
# are for local development only and use the local postgres bootstrap login.
MIGRATIONS_DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/argus
BACKUP_DATABASE_USER=postgres
BACKUP_DATABASE_PASSWORD=
BACKUP_DATABASE_HOST=db
BACKUP_DATABASE_PORT=5432
BACKUP_DATABASE_NAME=argus
BACKUP_DATABASE_SSLMODE=prefer
RESTORE_DATABASE_USER=postgres
RESTORE_DATABASE_PASSWORD=
RESTORE_DATABASE_HOST=db
RESTORE_DATABASE_PORT=5432
RESTORE_DATABASE_SSLMODE=prefer

# Used by migration/maintenance commands only. Never pass this credential to api.
DATABASE_URL_MIGRATIONS=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5433/argus
# Fill these with matching passwords for local processes outside Compose.
DATABASE_URL_HR_ADMIN=postgresql+asyncpg://hr_admin:REPLACE_WITH_HR_ADMIN_PASSWORD@localhost:5433/argus
DATABASE_URL_COMPLIANCE_AUDITOR=postgresql+asyncpg://compliance_auditor:REPLACE_WITH_COMPLIANCE_AUDITOR_PASSWORD@localhost:5433/argus

# Supabase Free (shared pooler session mode). Use the exact host shown by
# Supabase Connect. Put the postgres password in both migration variables;
# percent-encode reserved characters in each URL password.
# MIGRATIONS_DATABASE_URL=postgresql://postgres.jdfakmmbydbnupndcytf:<encoded-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL_MIGRATIONS=postgresql://postgres.jdfakmmbydbnupndcytf:<encoded-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# After creating the runtime roles, use their Supabase pooler usernames:
# COMPOSE_DATABASE_URL_HR_ADMIN=postgresql+asyncpg://hr_admin.jdfakmmbydbnupndcytf:<encoded-role-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# COMPOSE_DATABASE_URL_COMPLIANCE_AUDITOR=postgresql+asyncpg://compliance_auditor.jdfakmmbydbnupndcytf:<encoded-role-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional complete URLs for the API when it runs in Compose against a hosted
# PostgreSQL service instead of the local `db` container. Use URL-encoded
# passwords and require TLS with `?sslmode=require`.
COMPOSE_DATABASE_URL_HR_ADMIN=
COMPOSE_DATABASE_URL_COMPLIANCE_AUDITOR=

VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=/api
CLERK_JWT_KEY=
CLERK_ISSUER=
# Exact frontend origin(s) that may issue Clerk session tokens, comma-separated.
CLERK_AUTHORIZED_PARTIES=
HR_ADMIN_EMAILS=
COMPLIANCE_AUDITOR_EMAILS=
CORS_ORIGINS=http://localhost,http://localhost:5173
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1

# Ops profile: backups stay in this host directory until you configure an
# independent off-site copy/retention policy. Do not use the DB volume itself.
ARGUS_BACKUP_DIR=./backups
# Restore is staging-only and requires explicit target + confirmation each run.
RESTORE_BACKUP_DIR=
RESTORE_TARGET_DATABASE=argus_restore_unconfigured
ARGUS_RESTORE_CONFIRM=

# PII_ENCRYPTION_KEY: URL-safe Base64 for exactly 32 random bytes.
PII_ENCRYPTION_KEY=
# AUDIT_SALT: at least 32 unique random bytes. Keep stable for existing indexes.
AUDIT_SALT=
# AUDIT_CONTEXT_SECRET: 64+ hex chars (32+ random bytes), separate from AUDIT_SALT.
# It is provisioned in the DB by migration 019 and used only by the API signer/verifier.
AUDIT_CONTEXT_SECRET=
AUDIT_CONTEXT_KEY_ID=v1

# Path to the Ed25519 private key file mounted read-only into the API container.
SIGNING_PRIVATE_KEY_FILE=
SIGNING_PRIVATE_KEY_PATH=/run/secrets/argus_signing_private_key.pem
CHECKPOINT_PUBLIC_KEYS_DIR=/app/trusted-checkpoint-keys
# Put trusted checkpoint public keys in ./trusted-checkpoint-keys. Legacy rows
# use public_key.pem; key ID local:ed25519:v1 also uses that filename. Other
# IDs use their URL-escaped value plus .pem (for example local%3Aed25519%3Av2.pem).
WITNESS_PUBLIC_KEYS_DIR=/app/trusted-witness-keys
WITNESS_STORE_PATH=/app/anchor/multi_witness
# Store only out-of-band trusted witness public keys here, URL-escaped by witness
# identity and ending in .pem. Never use private signing keys in this directory.
ANCHOR_STORE=local_file
ANCHOR_FILE_PATH=/app/anchor/chain_anchor.log
CHECKPOINT_INTERVAL=25
SUSPICIOUS_ACTIVITY_REFRESH_SECONDS=30
